# Settings for docker-compose.yml. Copy to .env and change every "change-me" (`openssl rand -hex 24` makes a good
# secret). Keep .env private.

# Server key: every player puts it in their game's settings. Not a real secret (it travels with the game), but only
# games that know it can use the server: give it to your group, not the world.
NAKAMA_SERVER_KEY=change-me-server-key
# These sign players' logins: keep them private.
NAKAMA_SESSION_KEY=change-me-session-key
NAKAMA_REFRESH_KEY=change-me-refresh-key
# Server-to-server HTTP key (the game doesn't use it, but it must not stay at Nakama's default).
NAKAMA_HTTP_KEY=change-me-http-key

# Admin console: http://127.0.0.1:7351 on the server (from elsewhere: ssh -L 7351:127.0.0.1:7351 you@server).
NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=change-me-console-password
NAKAMA_CONSOLE_SIGNING_KEY=change-me-console-signing-key
NAKAMA_LOG_LEVEL=INFO

# Where the game connects: 0.0.0.0 = every network of this machine; 127.0.0.1 = only through a reverse proxy here.
NAKAMA_API_BIND=0.0.0.0
NAKAMA_API_PORT=7350
NAKAMA_CONSOLE_BIND=127.0.0.1
NAKAMA_CONSOLE_PORT=7351

# HTTPS with docker-compose.caddy.yml: the server's domain name (a DNS record must point it here).
SERVER_DOMAIN=coop.example.com

# Database (only accounts and the lobby list live here: nothing precious).
POSTGRES_USER=nakama
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=nakama
